# Local development only. These example credentials are public and must never be used in production.
DATA_MODE=mock
DATABASE_URL=postgresql://portfolio_local:local_only_change_me@127.0.0.1:5432/portfolio_pilot
REDIS_URL=redis://127.0.0.1:6379
ANTHROPIC_API_KEY=
AGENT_MODE=
AGENT_MODEL_ID=
# Absolute directory outside this source repository, dedicated to SDK runtime data.
AGENT_WORKSPACE_DIR=

# Explicit local-only opt-in. Production refuses this setting.
DEMO_AUTH_ENABLED=true
AUTH_BASE_URL=http://localhost:5173
# Optional locally; required in production (at least 32 random characters).
# AUTH_SECRET=
# Omit all Entra settings for the credential-free local demo.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# Deterministic mock schedule; no external credentials required.
MOCK_NEWS_INTERVAL_MS=30000
MOCK_SCENARIO=ordinary
# Optional fixed UTC epoch for repeatable replay; otherwise starts with the API process.
# MOCK_START_AT=2026-10-02T12:00:00.000Z
